{
  "name": "@6g-dali/ui-theme",
  "version": "0.4.0",
  "description": "Shared CSS layer for the 6G-DALI front ends: design tokens, theme, utilities and app-shell styling. No framework dependency.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6G-DALI/common-ui.git",
    "directory": "packages/ui-theme"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./index.css",
    "./index.css": "./index.css",
    "./tokens.css": "./tokens.css",
    "./animations.css": "./animations.css",
    "./theme.css": "./theme.css",
    "./ui.css": "./ui.css",
    "./base.css": "./base.css",
    "./fonts.css": "./fonts.css",
    "./shell.css": "./shell.css",
    "./assets/*": "./assets/*",
    "./theme.js": {
      "types": "./theme.d.ts",
      "default": "./theme.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.css",
    "assets",
    "theme.js",
    "theme.d.ts"
  ],
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/space-mono": "^5.2.5"
  }
}
