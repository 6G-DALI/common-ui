{
  "name": "@6g-dali/ui-shell",
  "version": "0.1.2",
  "description": "Shared React application shell for the 6G-DALI front ends: navbar, sidebar, breadcrumb, footer, and the runtime config and Keycloak helpers they agree on.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6G-DALI/common-ui.git",
    "directory": "packages/ui-shell"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@6g-dali/ui-theme": "0.1.2"
  },
  "peerDependencies": {
    "keycloak-js": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "keycloak-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "keycloak-js": "^26.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
