{
  "name": "@6g-dali/ui-shell-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Shared front-end layer for the 6G-DALI UIs.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @6g-dali/ui-shell",
    "type-check": "npm run type-check -w @6g-dali/ui-shell",
    "version:set": "npm version --workspaces --include-workspace-root --no-git-tag-version"
  },
  "engines": {
    "node": ">=20"
  }
}
